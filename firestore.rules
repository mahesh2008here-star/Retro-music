rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSource(source) {
      return source in ['AUDIUS', 'ITUNES'];
    }

    function isValidCapability(capability) {
      return capability in ['FULL_STREAM', 'PREVIEW_30S', 'METADATA_ONLY', 'EXTERNAL_LINK'];
    }

    function isValidQuality(quality) {
      return quality in ['HIGH', 'STANDARD', 'DATA_SAVER'];
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             isValidQuality(data.preferredQuality) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTrackFields(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.trackKey is string && data.trackKey.size() >= 1 && data.trackKey.size() <= 128 &&
             isValidSource(data.source) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 120 &&
             data.album is string && data.album.size() <= 160 &&
             data.artworkUrl is string && data.artworkUrl.size() <= 500 &&
             data.streamUrl is string && data.streamUrl.size() <= 500 &&
             data.externalUrl is string && data.externalUrl.size() <= 500 &&
             data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 86400000 &&
             isValidCapability(data.capability) &&
             data.genre is string && data.genre.size() <= 60;
    }

    function isValidLikedTrack(data, userId) {
      return isValidTrackFields(data, userId) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPlaylist(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.description is string && data.description.size() <= 240 &&
             data.artworkUrl is string && data.artworkUrl.size() <= 500 &&
             data.trackCount is int && data.trackCount >= 0 && data.trackCount <= 5000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPlaylistTrack(data, userId, playlistId) {
      return isValidTrackFields(data, userId) &&
             data.playlistId is string && data.playlistId == playlistId &&
             data.position is int && data.position >= 0 && data.position <= 5000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSavedAlbum(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.albumKey is string && data.albumKey.size() >= 1 && data.albumKey.size() <= 128 &&
             isValidSource(data.source) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 120 &&
             data.artworkUrl is string && data.artworkUrl.size() <= 500 &&
             data.externalUrl is string && data.externalUrl.size() <= 500 &&
             data.releaseYear is string && data.releaseYear.size() <= 16 &&
             data.trackCount is int && data.trackCount >= 0 && data.trackCount <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFollowedArtist(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.artistKey is string && data.artistKey.size() >= 1 && data.artistKey.size() <= 128 &&
             isValidSource(data.source) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.artworkUrl is string && data.artworkUrl.size() <= 500 &&
             data.genre is string && data.genre.size() <= 60 &&
             data.externalUrl is string && data.externalUrl.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidHistoryEntry(data, userId) {
      return isValidTrackFields(data, userId) &&
             data.playedAt is timestamp && data.playedAt <= request.time;
    }

    // --- USER PROFILE & LIBRARY COLLECTIONS ---
    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredQuality', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'preferredQuality', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'preferredQuality', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /liked_tracks/{trackId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(trackId);

        allow create: if isOwner(userId) &&
                         isValidId(trackId) &&
                         incoming().keys().hasAll(['userId', 'trackKey', 'source', 'title', 'artist', 'album', 'artworkUrl', 'streamUrl', 'externalUrl', 'durationMs', 'capability', 'genre', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'trackKey', 'source', 'title', 'artist', 'album', 'artworkUrl', 'streamUrl', 'externalUrl', 'durationMs', 'capability', 'genre', 'createdAt']) &&
                         isValidLikedTrack(incoming(), userId);

        allow update: if false;
      }

      match /playlists/{playlistId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(playlistId);

        allow create: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         incoming().keys().hasAll(['userId', 'name', 'description', 'artworkUrl', 'trackCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'description', 'artworkUrl', 'trackCount', 'createdAt', 'updatedAt']) &&
                         isValidPlaylist(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(playlistId) &&
                         isValidPlaylist(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'artworkUrl', 'trackCount', 'updatedAt']);

        match /tracks/{entryId} {
          allow list: if isOwner(userId);
          allow get, delete: if isOwner(userId) && isValidId(playlistId) && isValidId(entryId);

          allow create: if isOwner(userId) &&
                           isValidId(playlistId) &&
                           isValidId(entryId) &&
                           incoming().keys().hasAll(['userId', 'playlistId', 'trackKey', 'source', 'title', 'artist', 'album', 'artworkUrl', 'streamUrl', 'externalUrl', 'durationMs', 'capability', 'genre', 'position', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'playlistId', 'trackKey', 'source', 'title', 'artist', 'album', 'artworkUrl', 'streamUrl', 'externalUrl', 'durationMs', 'capability', 'genre', 'position', 'createdAt']) &&
                           isValidPlaylistTrack(incoming(), userId, playlistId) &&
                           exists(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId));

          allow update: if isOwner(userId) &&
                           isValidId(playlistId) &&
                           isValidId(entryId) &&
                           isValidPlaylistTrack(incoming(), userId, playlistId) &&
                           incoming().userId == existing().userId &&
                           incoming().playlistId == existing().playlistId &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['position']);
        }
      }

      match /saved_albums/{albumId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(albumId);

        allow create: if isOwner(userId) &&
                         isValidId(albumId) &&
                         incoming().keys().hasAll(['userId', 'albumKey', 'source', 'title', 'artist', 'artworkUrl', 'externalUrl', 'releaseYear', 'trackCount', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'albumKey', 'source', 'title', 'artist', 'artworkUrl', 'externalUrl', 'releaseYear', 'trackCount', 'createdAt']) &&
                         isValidSavedAlbum(incoming(), userId);

        allow update: if false;
      }

      match /followed_artists/{artistId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(artistId);

        allow create: if isOwner(userId) &&
                         isValidId(artistId) &&
                         incoming().keys().hasAll(['userId', 'artistKey', 'source', 'name', 'artworkUrl', 'genre', 'externalUrl', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'artistKey', 'source', 'name', 'artworkUrl', 'genre', 'externalUrl', 'createdAt']) &&
                         isValidFollowedArtist(incoming(), userId);

        allow update: if false;
      }

      match /listening_history/{historyId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(historyId);

        allow create: if isOwner(userId) &&
                         isValidId(historyId) &&
                         incoming().keys().hasAll(['userId', 'trackKey', 'source', 'title', 'artist', 'album', 'artworkUrl', 'streamUrl', 'externalUrl', 'durationMs', 'capability', 'genre', 'playedAt']) &&
                         incoming().keys().hasOnly(['userId', 'trackKey', 'source', 'title', 'artist', 'album', 'artworkUrl', 'streamUrl', 'externalUrl', 'durationMs', 'capability', 'genre', 'playedAt']) &&
                         isValidHistoryEntry(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(historyId) &&
                         isValidHistoryEntry(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['playedAt', 'streamUrl', 'artworkUrl']);
      }
    }
  }
}
